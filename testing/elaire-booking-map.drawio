<mxfile host="app.diagrams.net"><diagram name="Карта функционала" id="map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1660" pageHeight="674"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="&lt;b&gt;Запись в салон ÉLAIRE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3E5A47;strokeColor=#3E5A47;fontColor=white;fontSize=16;" vertex="1" parent="1"><mxGeometry x="640.0" y="10" width="340" height="56" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;М1. Каркас и навигация&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7DD;strokeColor=#3E5A47;fontColor=#1F2E24;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id="m0c0" value="&lt;b&gt;Шапка&lt;/b&gt;&lt;br&gt;• Логотип: переход на главную&lt;br&gt;• Меню: 4 раздела сайта&lt;br&gt;• Кнопка «Войти»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="260" height="102" as="geometry"/></mxCell><mxCell id="m0c1" value="&lt;b&gt;Индикатор шагов&lt;/b&gt;&lt;br&gt;• 3 шага записи&lt;br&gt;• Активный шаг выделен&lt;br&gt;• Пройденные шаги отмечены" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="260" height="102" as="geometry"/></mxCell><mxCell id="m0c2" value="&lt;b&gt;Кнопка «Назад»&lt;/b&gt;&lt;br&gt;• Возврат на предыдущий шаг&lt;br&gt;• Сохранение выбора" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="260" height="82" as="geometry"/></mxCell><mxCell id="m0c3" value="&lt;b&gt;Адаптивность&lt;/b&gt;&lt;br&gt;• Отображение на телефоне (375 px)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="260" height="62" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;М2. Выбор услуги&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7DD;strokeColor=#3E5A47;fontColor=#1F2E24;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id="m1c0" value="&lt;b&gt;Список категорий&lt;/b&gt;&lt;br&gt;• Название категории&lt;br&gt;• Счётчик услуг&lt;br&gt;• Выбор одной категории&lt;br&gt;• Кнопка «← Категории»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="260" height="122" as="geometry"/></mxCell><mxCell id="m1c1" value="&lt;b&gt;Список услуг&lt;/b&gt;&lt;br&gt;• Название и описание&lt;br&gt;• Длительность, мин&lt;br&gt;• Цена, ₽&lt;br&gt;• Кнопка «Выбрать»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="344" width="260" height="122" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;М3. Дата и время&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7DD;strokeColor=#3E5A47;fontColor=#1F2E24;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id="m2c0" value="&lt;b&gt;Календарь&lt;/b&gt;&lt;br&gt;• Месяц и год&lt;br&gt;• Стрелки ‹ ›&lt;br&gt;• Прошлые дни неактивны&lt;br&gt;• Выбранный день" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="260" height="122" as="geometry"/></mxCell><mxCell id="m2c1" value="&lt;b&gt;Слоты времени&lt;/b&gt;&lt;br&gt;• Свободный слот&lt;br&gt;• Занятый слот&lt;br&gt;• Прошедшее время&lt;br&gt;• Выбранный слот" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="344" width="260" height="122" as="geometry"/></mxCell><mxCell id="m2c2" value="&lt;b&gt;Нижняя панель&lt;/b&gt;&lt;br&gt;• День недели, дата, время&lt;br&gt;• Кнопка «Далее»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="488" width="260" height="82" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;М4. Подтверждение&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7DD;strokeColor=#3E5A47;fontColor=#1F2E24;fontSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id="m3c0" value="&lt;b&gt;Детали визита&lt;/b&gt;&lt;br&gt;• Услуга, дата и время&lt;br&gt;• Мастер, длительность&lt;br&gt;• Сумма к оплате" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="200" width="260" height="102" as="geometry"/></mxCell><mxCell id="m3c1" value="&lt;b&gt;Контактные данные&lt;/b&gt;&lt;br&gt;• Имя: кириллица 2–40&lt;br&gt;• Телефон: маска +7&lt;br&gt;• Комментарий" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="324" width="260" height="102" as="geometry"/></mxCell><mxCell id="m3c2" value="&lt;b&gt;Подтверждение&lt;/b&gt;&lt;br&gt;• Кнопка «Подтвердить запись»&lt;br&gt;• Сообщение об успехе" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="448" width="260" height="82" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;М5. Данные и сервер&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE7DD;strokeColor=#3E5A47;fontColor=#1F2E24;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id="m4c0" value="&lt;b&gt;Запросы&lt;/b&gt;&lt;br&gt;• «Сегодня» с сервера&lt;br&gt;• Слоты на дату&lt;br&gt;• Создание записи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="260" height="102" as="geometry"/></mxCell><mxCell id="m4c1" value="&lt;b&gt;Состояния&lt;/b&gt;&lt;br&gt;• Загрузка…&lt;br&gt;• Ошибка и «Попробовать снова»&lt;br&gt;• Защита от гонок&lt;br&gt;• Конфликт слота" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFFFFF;strokeColor=#8AA092;fontColor=#1F2E24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="324" width="260" height="122" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#3E5A47;" edge="1" parent="1" source="root" target="m0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endSize=4;strokeColor=#8AA092;exitX=0.06;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source